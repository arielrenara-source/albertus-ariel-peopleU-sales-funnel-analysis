-- Segmentation Query 4: Top combinations - industry + source + company size
WITH leads_with_deal AS (
  SELECT
    l.leads_id,
    i.industry,
    ss.session_source,
    CASE
      WHEN l.number_of_employee BETWEEN 1   AND 50   THEN 'Small (1-50)'
      WHEN l.number_of_employee BETWEEN 51  AND 200  THEN 'Medium (51-200)'
      WHEN l.number_of_employee BETWEEN 201 AND 500  THEN 'Large (201-500)'
      WHEN l.number_of_employee > 500                THEN 'Enterprise (500+)'
      ELSE 'Unknown'
    END AS company_size,
    MAX(CASE WHEN f.stage_id = 108 THEN 1 ELSE 0 END) AS is_deal_won
  FROM `nextproject-001.DES_SaaS.leads` l
  JOIN `nextproject-001.DES_SaaS.industries`     i  ON l.industry_code       = i.industry_code
  JOIN `nextproject-001.DES_SaaS.sessions_source` ss ON l.session_source_code = ss.session_source_code
  LEFT JOIN `nextproject-001.DES_SaaS.funnel_new`   f  ON l.leads_id             = f.leads_id
                                          AND f.TimeStamp < '2023-01-01'
  WHERE l.leads_registered < '2023-01-01'
  GROUP BY l.leads_id, i.industry, ss.session_source, l.number_of_employee
)
SELECT
  industry,
  session_source,
  company_size,
  COUNT(*)                                         AS total_leads,
  SUM(is_deal_won)                                 AS total_deal_won,
  ROUND(SUM(is_deal_won) / COUNT(*) * 100, 1)      AS conversion_rate_pct
FROM leads_with_deal
GROUP BY industry, session_source, company_size
HAVING COUNT(*) >= 10 
ORDER BY conversion_rate_pct DESC
LIMIT 10
